      "local_path": "/host-repo",
      "nextcloud_path": "/Code/SharedLLM",
      "repo_url": "https://github.com/JMiahMan1/SharedLLM.git",
      "git_remote": "origin",
      "default_branch": "microservices",
      "sync_mode": "local_git_authoritative",
      "auto_pull_enabled": true,
      "auto_backup_enabled": true,
      "excludes": ["node_modules", ".venv", "venv", ".git", "__pycache__", ".pytest_cache", ".cache", ".local", ".vscode", ".idea", "dist", "build", ".tox", ".nox"]
