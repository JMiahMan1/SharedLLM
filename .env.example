# --- Identity / Auth ---
HA_DEFAULT_USER=
DEFAULT_ADMIN_PASSWORD=

# --- DNS Mappings (seeds dns_mappings in Identity DB; JSON format) ---
# Example: {"ai.local": ["host-gateway"], "execution.local": ["host-gateway"], "ollama-server.local": ["192.168.2.200", "192.168.1.216"]}
DNS_MAPPINGS=

# --- Live Test (scripts/test-media-player.js) ---
JARVIS_HOST=https://jarvis.sumemail.com
JARVIS_USER=
JARVIS_PASS=
