# Copy to .env and fill in your actual values. NEVER commit .env.
# See services/README.md for details.

# --- Identity / Auth ---
HA_DEFAULT_USER=
DEFAULT_ADMIN_PASSWORD=

# --- Docker Image Updates (Admin Services page) ---
# GitHub PAT with packages:read scope. Used by the Control Plane to check
# for available image updates on GHCR and to pull new images.
# If unset, the Control Plane falls back to the github_token stored for
# user ID 1 in the Identity service.
GHCR_TOKEN=
GITHUB_TOKEN=

# --- Local LLM (Ollama / Alpaca) ---
# Seed source of truth for llm_local_url. Surfaced to runtime via the
# Identity config DB (llm_local_url) once seeded; not hardcoded in code.
OLLAMA_URL=http://jeremiah-home-desktop.local:11434

# --- DNS Mappings (seeds dns_mappings in Identity DB; JSON format) ---
# Example: {"ai.local": ["host-gateway"], "execution.local": ["host-gateway"], "jeremiah-home-desktop.local": ["192.168.1.216"]}
DNS_MAPPINGS=

# --- Health-aware DNS failover (seeds Identity global settings; editable in UI) ---
# When a host maps to multiple IPs, only reachable IPs are returned (device must be powered on).
DNS_FAILOVER_ENABLED=true
# Comma-separated TCP ports probed to check if an IP is reachable.
DNS_HEALTH_PORTS=11434,80,443,8080,8000,9000
# Optional HTTP path (e.g. /api/health) probed instead of raw TCP ports. Leave empty for TCP-only.
DNS_HEALTH_PATH=

# --- Initial DNS Records (seeds DnsRecord table in Identity DB; JSON format) ---
# Only seeds if table is empty or FORCE_DNS_SEED=true. Managed via UI after initial seed.
# Example: [{"domain": "ollama-server.local", "type": "A", "values": ["192.168.2.200"], "ttl": 300}, {"domain": "api.local", "type": "CNAME", "values": ["control-plane.local"], "ttl": 600}]
INITIAL_DNS_RECORDS=

# --- Force DNS Seed (set to true to re-seed DNS records on startup) ---
# FORCE_DNS_SEED=true

# --- Execution Service Paths (seeded to Identity global settings; editable in UI) ---
# Temp directory for downloaded/transcoded media (video, audio, TTS caches).
TEMP_MEDIA_DIR=/tmp/sharedllm_media
# Root directory where workspaces are cloned/checked out.
WORKSPACE_ROOT=/data
# Directory for downloaded models.
MODELS_DIR=/app/models
# Root directory for local notes storage.
LOCAL_NOTES_ROOT=
# Path to the phrasebook data file.
PHRASEBOOK_PATH=

# --- Live Test (scripts/test-media-player.js) ---
JARVIS_HOST=https://jarvis.sumemail.com
JARVIS_USER=
JARVIS_PASS=
