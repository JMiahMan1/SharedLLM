# =============================================================================
# SharedLLM Environment Configuration
# Copy to .env and fill in your actual values. NEVER commit .env.
#
# Only secrets and external service endpoints belong here.
# All other defaults are defined in services/config.py.
# =============================================================================

# ---- Required Secrets ----
# Internal service-to-service authentication
INTERNAL_SECRET=change-me-in-production

# Fernet encryption key for credential storage (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your-fernet-key-here

# ---- Required Service URLs ----
# These must be set for all services to communicate.
OLLAMA_URL=http://ollama-server:11434
IDENTITY_SVC_URL=http://identity:8001
EXECUTION_SVC_URL=http://execution:8003
RAG_SVC_URL=http://rag:8004
STORAGE_SVC_URL=http://storage:8005
LOGGING_SVC_URL=http://logging:8006
WORKSPACE_RUNTIME_SVC_URL=http://workspace-runtime:8007

# ---- Optional Service URLs ----
CONTROL_PLANE_URL=http://control-plane:8008
LLAMA_SERVER_PROXY_URL=

# ---- Web Search ----
SEARXNG_URL=https://search.example.com/

# ---- Home Assistant ----
HA_URL=https://ha.example.com
HA_TOKEN=your-long-lived-access-token

# ---- Nextcloud ----
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=your-username
NEXTCLOUD_PASS=your-password

# ---- Git (optional, for Raven push/pull) ----
GIT_URL=https://github.com/your-org/SharedLLM.git
GIT_USER=your-username
GIT_TOKEN=your-personal-access-token

# ---- GitLab (optional, for workspace sync) ----
GITLAB_URL=
GITLAB_USER=
GITLAB_TOKEN=

# ---- Audiobookshelf (optional) ----
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_USER=
AUDIOBOOKSHELF_PASS=

# ---- Runtime Paths ----
# Adjust these if your container/install layout differs from defaults.
MODELS_DIR=/app/models
TEMP_MEDIA_DIR=/tmp/sharedllm_media
SCRIPTS_DIR=/app/scripts
LEGACY_ENV_PATH=/app/.env.legacy
WORKSPACE_ROOT=/workspaces
WORKSPACE_RUNTIME_ROOT=/workspace

# ---- External Host ----
# The IP/hostname that Home Assistant and other external systems use to reach the Execution service.
EXECUTION_EXTERNAL_HOST=192.168.1.100

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- DNS Sync (optional sidecar) ----
DNS_CONF_PATH=/etc/dnsmasq.conf
UPSTREAM_DNS=8.8.8.8,1.1.1.1

# ---- Misc ----
TIMEZONE=America/New_York
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_TTS_VOICE=af_heart
FAST_PATH_THRESHOLD=0.85
