# ---- Ollama (internal) ----
OLLAMA_URL=http://ollama.local

# ---- Unified RAG API ----
# (Optional) Hostname this service will be reachable at on your LAN (used for logs)
# (Optional) Hostname this service will be reachable at on your LAN (used for logs)
RAG_HOSTNAME=rag.local
RAG_ADDRESS=192.168.2.211

# ---- Home Assistant ----
HA_URL=https://ha.local
HA_DEFAULT_USER=Admin
HA_TOKEN=<TOKEN>

# ---- Nextcloud ----
NEXTCLOUD_URL=https://cloud.local
NEXTCLOUD_USER=<USERNAME>
NEXTCLOUD_PASS=<PASSWORD>

# ---- Chroma / embeddings ----
CHROMA_PERSIST_DIR=/data/chroma_db

# ---- Optional behavior ----
DEFAULT_MODEL=qwen3:8b
