# Copy to .env and fill in your actual values. NEVER commit .env.
# See services/README.md for details.

# --- Identity / Auth ---
HA_DEFAULT_USER=
DEFAULT_ADMIN_PASSWORD=

# --- Docker Image Updates (Admin Services page) ---
# GitHub PAT with packages:read scope. Used by the Control Plane to check
# for available image updates on GHCR and to pull new images.
# If unset, the Control Plane falls back to the github_token stored for
# user ID 1 in the Identity service.
GHCR_TOKEN=
GITHUB_TOKEN=

# --- Local LLM (Ollama / Alpaca) ---
# Seed source of truth for llm_local_url. Surfaced to runtime via the
# Identity config DB (llm_local_url) once seeded; not hardcoded in code.
OLLAMA_URL=http://jeremiah-home-desktop.local:11434

# --- Device-facing host address ---
# This host's LAN address as TVs, speakers and phones can reach it. The execution
# service runs on the host network and builds every Audiobookshelf stream URL from
# this, so a docker service alias will not work. Leave blank and audiobooks and
# video will refuse to play with a clear "not configured" message.
EXECUTION_EXTERNAL_HOST=

# --- Alpaca service backends (all on the same host as Ollama) ---
# Image generation. Routed to by sharedllm_image_generate / _edit / _list.
ALPACA_SD_URL=http://jeremiah-home-desktop.local:8081
# Dashboard, port 5000. Serves /api/podcast/* - the podcast mixer, the curated
# host roster and the enrolled OpenVoice voice profiles.
ALPACA_WEB_URL=http://jeremiah-home-desktop.local:5000
# Audio server, port 8082. Speaker identification ONLY (it needs OpenVoice's
# reference encoder, which lives here because this is the only service with
# torch). No default on purpose: unset, sharedllm_speaker_identify fails with a
# clear message rather than probing a guessed host.
ALPACA_AUDIO_URL=http://jeremiah-home-desktop.local:8082

# --- DNS Mappings (seeds dns_mappings in Identity DB; JSON format) ---
# Example: {"ai.local": ["host-gateway"], "execution.local": ["host-gateway"], "jeremiah-home-desktop.local": ["192.168.1.216"]}
DNS_MAPPINGS=

# --- Health-aware DNS failover (seeds Identity global settings; editable in UI) ---
# When a host maps to multiple IPs, only reachable IPs are returned (device must be powered on).
DNS_FAILOVER_ENABLED=true
# Comma-separated TCP ports probed to check if an IP is reachable.
DNS_HEALTH_PORTS=11434,80,443,8080,8000,9000
# Optional HTTP path (e.g. /api/health) probed instead of raw TCP ports. Leave empty for TCP-only.
DNS_HEALTH_PATH=

# --- Initial DNS Records (seeds DnsRecord table in Identity DB; JSON format) ---
# Only seeds if table is empty or FORCE_DNS_SEED=true. Managed via UI after initial seed.
# Example: [{"domain": "ollama-server.local", "type": "A", "values": ["192.168.2.200"], "ttl": 300}, {"domain": "api.local", "type": "CNAME", "values": ["control-plane.local"], "ttl": 600}]
INITIAL_DNS_RECORDS=

# --- Force DNS Seed (set to true to re-seed DNS records on startup) ---
# FORCE_DNS_SEED=true

# --- Execution Service Paths (seeded to Identity global settings; editable in UI) ---
# Temp directory for downloaded/transcoded media (video, audio, TTS caches).
TEMP_MEDIA_DIR=/tmp/sharedllm_media
# TLS verification is ON by default for media/HA/ABS HTTP clients (BUG-09).
# Only set to true if a self-signed device endpoint must be reached:
# MEDIA_ALLOW_INSECURE_TLS=false
# Root directory where workspaces are cloned/checked out.
WORKSPACE_ROOT=/data
# Directory for downloaded models.
MODELS_DIR=/app/models
# Root directory for local notes storage.
LOCAL_NOTES_ROOT=
# Path to the phrasebook data file.
PHRASEBOOK_PATH=

# --- Live Test (scripts/test-media-player.js) ---
JARVIS_HOST=https://jarvis.sumemail.com
JARVIS_USER=
JARVIS_PASS=

# --- Host paths bind-mounted by docker-compose (REQUIRED) ---
# These name directories on the *host*; the Docker daemon resolves them there.
# Compose refuses to start without them (${VAR:?...}) rather than guessing,
# because a wrong guess silently creates empty, root-owned directories.
# Existing installs: copy the values your containers already use, e.g.
#   docker inspect <container> --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}'
# Mounted at /workspaces for the execution service and workspace_runtime.
WORKSPACE_HOST_PATH=
# Mounted at /home/sharedllm/.ssh (read-only) for git-over-SSH.
HOST_SSH_DIR=
# This checkout on the host, mounted at /host-repo.
REPO_HOST_PATH=
