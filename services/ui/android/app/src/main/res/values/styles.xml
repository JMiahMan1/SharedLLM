<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- What shows in the strip behind the bars until the page names its own
             colour: the app's dark background, never the light theme's white. -->
        <item name="android:windowBackground">@color/jarvis_background</item>
        <item name="android:statusBarColor">#030711</item>
        <item name="android:navigationBarColor">#030711</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- No windowTranslucentStatus/Navigation: those legacy flags fight
             Capacitor 8's edge-to-edge inset handling (SystemBars), which pads
             or passes the bar insets to the page itself. -->
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_bg</item>
    </style>
</resources>
