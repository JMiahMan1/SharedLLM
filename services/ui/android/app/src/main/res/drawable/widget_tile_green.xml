<?xml version="1.0" encoding="utf-8"?>
<!-- Action-button tile tinted with the "green" chip colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <inset
                    android:insetLeft="3dp"
                    android:insetTop="3dp"
                    android:insetRight="3dp"
                    android:insetBottom="3dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#F22B3D5C" />
                        <corners android:radius="16dp" />
                        <stroke
                            android:width="1dp"
                            android:color="#804A5F85" />
                    </shape>
                </inset>
            </item>
            <item>
                <inset
                    android:insetLeft="3dp"
                    android:insetTop="3dp"
                    android:insetRight="3dp"
                    android:insetBottom="3dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#994ADE80" />
                        <corners android:radius="16dp" />
                    </shape>
                </inset>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E60F1724" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#33475569" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4D4ADE80" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
