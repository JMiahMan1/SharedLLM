<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis mascot mark: a friendly visor face with a lightning-bolt crest.
  Purple-forward, professional, slightly cute — deliberately not a stock
  Android/robot glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ambient glow -->
    <path
        android:pathData="M54,52 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z"
        android:fillColor="#6D28D9"
        android:fillAlpha="0.30" />

    <!-- side accents (gives the head a little character) -->
    <path
        android:pathData="M27,48 h4 a3,3 0 0,1 3,3 v9 a3,3 0 0,1 -3,3 h-4 a2,2 0 0,1 -2,-2 v-11 a2,2 0 0,1 2,-2 Z"
        android:fillColor="#7C3AED" />
    <path
        android:pathData="M81,48 h-4 a3,3 0 0,0 -3,3 v9 a3,3 0 0,0 3,3 h4 a2,2 0 0,0 2,-2 v-11 a2,2 0 0,0 -2,-2 Z"
        android:fillColor="#7C3AED" />

    <!-- head shell -->
    <path android:pathData="M30,54 C30,37 40,27 54,27 C68,27 78,37 78,54 L78,65 C78,74 71,80 62,80 L46,80 C37,80 30,74 30,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="28"
                android:endX="78"
                android:endY="80"
                android:type="linear">
                <item android:offset="0" android:color="#FFA78BFA" />
                <item android:offset="1" android:color="#FF7C3AED" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft top highlight -->
    <path
        android:pathData="M40,40 C45,33 63,33 68,40 C60,36 48,36 40,40 Z"
        android:fillColor="#EDE9FE"
        android:fillAlpha="0.55" />

    <!-- visor -->
    <path
        android:pathData="M39,45 h30 a7,7 0 0,1 7,7 v6 a7,7 0 0,1 -7,7 h-30 a7,7 0 0,1 -7,-7 v-6 a7,7 0 0,1 7,-7 Z"
        android:fillColor="#1E1B4B"
        android:fillAlpha="0.92" />

    <!-- eyes -->
    <path
        android:pathData="M46,55 m-4.2,0 a4.2,5.4 0 1,0 8.4,0 a4.2,5.4 0 1,0 -8.4,0 Z"
        android:fillColor="#EDE9FE" />
    <path
        android:pathData="M62,55 m-4.2,0 a4.2,5.4 0 1,0 8.4,0 a4.2,5.4 0 1,0 -8.4,0 Z"
        android:fillColor="#EDE9FE" />
    <path
        android:pathData="M47.4,52.6 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />
    <path
        android:pathData="M63.4,52.6 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />

    <!-- smile -->
    <path
        android:pathData="M48,70 Q54,74.5 60,70"
        android:fillColor="#00000000"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#DDD6FE" />

    <!-- cheeks -->
    <path
        android:pathData="M39,64 m-3,0 a3,2 0 1,0 6,0 a3,2 0 1,0 -6,0 Z"
        android:fillColor="#F0ABFC"
        android:fillAlpha="0.30" />
    <path
        android:pathData="M69,64 m-3,0 a3,2 0 1,0 6,0 a3,2 0 1,0 -6,0 Z"
        android:fillColor="#F0ABFC"
        android:fillAlpha="0.30" />

    <!-- lightning-bolt crest -->
    <path
        android:pathData="M58,12 L46,26 H52.5 L49,38 L63,22 H56.5 L60,12 Z"
        android:fillColor="#C4B5FD" />
    <path
        android:pathData="M58,12 L46,26 H52.5 L49,38 L63,22 H56.5 L60,12 Z"
        android:fillColor="#00000000"
        android:strokeWidth="1"
        android:strokeColor="#F5F3FF"
        android:strokeAlpha="0.65" />
</vector>
