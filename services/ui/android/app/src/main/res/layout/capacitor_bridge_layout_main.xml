<?xml version="1.0" encoding="utf-8"?>
<!--
  Capacitor's own layout with one change: the WebView is JarvisWebView, so the
  keyboard can insert GIFs and stickers into chat boxes. Same id, so the bridge
  finds it as before (Capacitor inflates it, which lint cannot see). Keep in step with @capacitor/android's copy of this file.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    tools:ignore="UnusedResources"
    >

    <com.jarvisos.app.JarvisWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
