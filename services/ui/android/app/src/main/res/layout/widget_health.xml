<?xml version="1.0" encoding="utf-8"?>
<!--
  Fitness: today's steps as a ring toward the goal, the 7-day average and a
  bar for each of the last seven days. Filled by HealthWidget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/health_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/wg_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/health_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/mi_steps"
            android:tint="#863BFF" />

        <TextView
            android:id="@+id/health_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="STEPS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="7dp" />

        <ImageView
            android:id="@+id/health_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mi_refresh"
            android:tint="#64748B"
            android:layout_marginStart="8dp"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

            <ProgressBar
                android:id="@+id/health_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:indeterminateOnly="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/wg_ring" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/health_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="-"
                    android:textColor="#F1F5F9"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/health_ring_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="steps"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/health_side"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/health_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/health_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_1"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_2"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_3"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_4"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_5"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_6"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:id="@+id/health_spark_7"
                            android:layout_width="8dp"
                            android:layout_height="4dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:background="@drawable/wg_pill" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/health_spark_day_7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/health_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminateOnly="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/wg_bar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/health_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
            android:visibility="gone" />
</LinearLayout>
