<?xml version="1.0" encoding="utf-8"?>
<!--
  Family Games: the signed-in member's own arcade card (games played, best
  score, #1 spots), from /api/arcade/scoreboard. Filled by GamesWidget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/wg_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/gw_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/mi_gamepad"
            android:tint="#863BFF" />

        <TextView
            android:id="@+id/gw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:text="FAMILY GAMES"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="7dp" />

        <ImageView
            android:id="@+id/gw_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mi_refresh"
            android:tint="#64748B"
            android:layout_marginStart="8dp"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="fill_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
            android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/gw_played_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/wg_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/gw_played_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mi_gamepad"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/gw_played_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="PLAYED"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/gw_played_value"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:text="-"
                android:textColor="#F1F5F9"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:id="@+id/gw_played_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gw_best_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/wg_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/gw_best_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mi_star"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/gw_best_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="BEST"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/gw_best_value"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:text="-"
                android:textColor="#F1F5F9"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:id="@+id/gw_best_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gw_crowns_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/wg_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/gw_crowns_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mi_trophy"
                    android:tint="#94A3B8" />

                <TextView
                    android:id="@+id/gw_crowns_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="CROWNS"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/gw_crowns_value"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:text="-"
                android:textColor="#F1F5F9"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:id="@+id/gw_crowns_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/gw_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
            android:visibility="gone" />
</LinearLayout>
