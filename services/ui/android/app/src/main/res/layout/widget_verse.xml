<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="VERSE OF THE DAY"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/verse_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text=""
            android:textColor="#FDBA74"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/verse_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/verse_widget_refresh_description"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <TextView
        android:id="@+id/verse_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#FCD34D"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="4"
        android:text=""
        android:textColor="#F1F5F9"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/verse_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#64748B"
        android:textSize="10sp" />
</LinearLayout>