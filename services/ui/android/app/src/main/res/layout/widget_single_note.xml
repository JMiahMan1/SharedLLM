<?xml version="1.0" encoding="utf-8"?>
<!--
  One chosen note. Checklist rows are individual TextViews so each box can
  carry its own tap target; a note without checkboxes falls back to the body
  text. Fixed rows rather than a list adapter because Home screen widgets
  cannot scroll a ListView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/single_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/single_note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="NOTE"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/single_note_configure"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/single_note_widget_configure_description"
            android:src="@android:drawable/ic_menu_edit" />

        <ImageView
            android:id="@+id/single_note_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/single_note_widget_refresh_description"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <TextView
        android:id="@+id/single_note_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="6"
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/note_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/single_note_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
