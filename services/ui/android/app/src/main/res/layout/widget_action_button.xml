<?xml version="1.0" encoding="utf-8"?>
<!--
  Action button: one device as a single big control. The circle fills with the
  accent while the device is on. Filled by ActionButtonWidget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/wg_card"
        android:clipToOutline="true"
        android:padding="8dp">

    <FrameLayout
        android:id="@+id/action_button"
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/action_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/wg_circle"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mi_power" />
    </FrameLayout>

    <TextView
        android:id="@+id/action_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#F1F5F9"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/action_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />
</LinearLayout>
