<?xml version="1.0" encoding="utf-8"?>
<!--
  Action button: one device as one icon, laid out like an app on the home
  screen: the icon fills most of the cell and the name sits under it, whole.
  "None" draws no tile at all (the glyph carries its own soft shadow so it
  reads on any wallpaper); a colour draws a rounded-square tile behind the
  glyph only. Sizes come from ActionButtonFit, per widget size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp">

    <FrameLayout
        android:id="@+id/action_button"
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/action_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mi_power" />
    </FrameLayout>

    <TextView
        android:id="@+id/action_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:text=""
        android:textColor="#F1F5F9"
        android:textSize="12sp"
        android:textStyle="bold"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:layout_marginTop="3dp" />

    <TextView
        android:id="@+id/action_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#E6FFFFFF"
        android:textSize="10sp"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:layout_marginTop="1dp" />
</LinearLayout>
