<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#F1F5F9"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Search entities for each cell. Changes apply as you save."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/entity_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/entity_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Cell 1"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/field_entity_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Type to search…"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
        <ListView
            android:id="@+id/entity_results_1"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="2dp"
            android:background="#1E293B"
            android:divider="#33475569"
            android:dividerHeight="1dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/preview_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cell 2"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/field_entity_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Type to search…"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
        <ListView
            android:id="@+id/entity_results_2"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="2dp"
            android:background="#1E293B"
            android:divider="#33475569"
            android:dividerHeight="1dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/preview_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cell 3"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/field_entity_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Type to search…"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
        <ListView
            android:id="@+id/entity_results_3"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="2dp"
            android:background="#1E293B"
            android:divider="#33475569"
            android:dividerHeight="1dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/preview_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cell 4"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/field_entity_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Type to search…"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:textSize="14sp" />
        <ListView
            android:id="@+id/entity_results_4"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="2dp"
            android:background="#1E293B"
            android:divider="#33475569"
            android:dividerHeight="1dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/preview_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#F8FAFC" />
            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="#4ADE80"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#0F172A" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
