# Public traffic reaches the :80 site through one reverse proxy
# (PUBLIC_PROXY_IP in .env). Trusting only that address keeps the client
# address it forwards in X-Forwarded-For, which ntfy needs to rate limit
# outside UnifiedPush senders (docs/PUSH.md, "Limits"). Any other peer has
# X-Forwarded-For replaced by its own address, so it cannot claim another.
{
    servers :80 {
        trusted_proxies static {$PUBLIC_PROXY_IP}
        protocols h1
    }

    # Every listener here is plaintext: TLS terminates on the public proxy, so
    # HTTP/2 and HTTP/3 cannot be negotiated and Caddy said so 22 times on every
    # start ("skipped because it requires TLS"). Asking for HTTP/1.1 states what
    # this config can actually do.
    servers {
        protocols h1
    }

    # Caddy's reverse proxy logs "aborting with incomplete response" at WARN every
    # time a long-lived stream ends -- the media events feed and the push stream,
    # whenever a phone closes the app or the screen sleeps. That is expected, and
    # it was 1400+ lines a day (measured 2026-10-26) drowning the warnings that
    # matter. Real failures from that logger are ERROR, so this raises its level
    # without touching the access log or any other logger.
    # Error logs ("http.log.error.*", e.g. a 502 while a service restarts) are
    # written by the default logger, not the site's access log, so the site's
    # token filter never saw them and the push stream's token was logged in
    # full. The same filter applies here.
    log default {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace mt REDACTED
                }
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
        exclude http.handlers.reverse_proxy
    }

    log reverse_proxy_noise {
        output stdout
        format json
        level ERROR
        include http.handlers.reverse_proxy
    }
}

# A deploy restarts a service for up to a minute. Without this, every request
# in that window failed at once with a 502 (390 of them on 2026-11-13, all at
# deploy times: long polls, the push stream, location) and the app showed
# errors. Caddy now keeps retrying the connection for a while first; it only
# retries when it could not connect, so no request is ever sent twice.
(patient) {
    lb_try_duration 45s
    lb_try_interval 500ms
}

# Cross-Network Routes (Host Network → Bridge Network)
:8001 {
    reverse_proxy identity:8001 {
        import patient
    }
}

:11435 {
    log {
        output stdout
        level INFO
        # Two secrets legitimately travel in a query string here: the git-pull
        # webhook's token, and the browser's ?token= on the Sendspin / JSON-RPC
        # WebSockets (a WebSocket handshake cannot carry an Authorization
        # header). Caddy's access log records the whole URI, so both were being
        # written to stdout in plain text -- confirmed live:
        #   /api/webhook/git-pull/sharedllm_system?token=s...
        # Redact them at the log, keep the rest of the URI for debugging.
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace mt REDACTED
                }
                request>headers>Authorization delete
            }
        }
    }
    handle /v1/* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /health {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /health/* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /execute* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle / {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
}

:8004 {
    reverse_proxy rag:8004 {
        import patient
    }
}

:8005 {
    reverse_proxy storage:8005 {
        import patient
    }
}

:8006 {
    reverse_proxy logging:8006 {
        import patient
    }
}

:8007 {
    reverse_proxy workspace_runtime:8007 {
        import patient
    }
}

:8008 {
    reverse_proxy control_plane:8008 {
        import patient
    }
}

:8009 {
    reverse_proxy geo:8009 {
        import patient
    }
}

:8010 {
    reverse_proxy bible:8010 {
        import patient
    }
}

# The phones' Home Assistant companion app, at the host name the apps were set
# up with (HOMEHUB_EXTERNAL_HOST in .env; the homehub "external_url" setting
# names the same host). TLS ends on the public proxy, which forwards it here
# with the Host header kept. Only what the app needs reaches the hub:
#   /api/webhook/*                 sensors, locations (the webhook id is the credential)
#   /api/mobile_app/registrations  a new phone (bearer token)
#   /auth/*                        log in and refresh tokens (HA's OAuth-like flow)
#   /api/websocket                 the app's live connection and local push (bearer token)
# Everything else (the REST API, /hub/* administration, camera media) answers
# 404 from outside; the LAN still reaches the hub on :8123 directly.
http://{$HOMEHUB_EXTERNAL_HOST:homehub.invalid} {
    log {
        output stdout
        level INFO
        # A webhook id is a bearer secret and sits in the path: keep it out of the log.
        format filter {
            wrap json
            fields {
                request>uri regexp ^/api/webhook/[^/?]+ /api/webhook/REDACTED
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
    }
    @companion path /api/webhook/* /api/mobile_app/registrations /auth/* /api/websocket
    handle @companion {
        request_body {
            max_size 1MB
        }
        reverse_proxy {$HOMEHUB_UPSTREAM:host.docker.internal:8123}
    }
    handle {
        respond 404
    }
}

# Standard Routes
:80 {
    log {
        output stdout
        level INFO
        # Two secrets legitimately travel in a query string here: the git-pull
        # webhook's token, and the browser's ?token= on the Sendspin / JSON-RPC
        # WebSockets (a WebSocket handshake cannot carry an Authorization
        # header). Caddy's access log records the whole URI, so both were being
        # written to stdout in plain text -- confirmed live:
        #   /api/webhook/git-pull/sharedllm_system?token=s...
        # Redact them at the log, keep the rest of the URI for debugging.
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace mt REDACTED
                }
                request>headers>Authorization delete
            }
        }
    }

    # "Jarvis is updating" (scripts/deploy_remote.sh writes it; the app's
    # banner reads it). Served from a file here, not by a service, so it still
    # answers while the services restart. No file yet: 404, read as "not updating".
    handle /api/deploy-status {
        root * /srv/deploy_status
        rewrite * /status.json
        header Cache-Control "no-store"
        file_server
    }

    # 2. Route Chat/Gateway API traffic
    handle /v1/* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/chat* {
        reverse_proxy gateway:11435 {
            import patient
