    }

    handle /control_plane* {
        uri strip_prefix /control_plane
        reverse_proxy control_plane:8008 {
            import patient
        }
    }

    # 3. Route Identity/Auth API traffic
    handle /api/auth* {
        reverse_proxy identity:8001 {
            import patient
        }
    }
    # Location endpoints go through gateway so X-Internal-Secret is injected
    # (identity requires it; phone/UI never send it → 422 if hit directly).
    handle /api/users/*/location {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/users/location* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/users* {
        reverse_proxy identity:8001 {
            import patient
        }
    }
    # Gateway routes under /api/devices (the watch's Home favorites, pairing
    # a companion device); everything else under it is identity's. Caddy
    # tries the longer path first.
    handle /api/devices/favorites* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/devices/pair* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/devices* {
        reverse_proxy identity:8001 {
            import patient
        }
    }
    handle /api/resolve* {
        reverse_proxy identity:8001 {
            import patient
        }
    }
    handle /api/widgets* {
        reverse_proxy identity:8001 {
            import patient
        }
    }
    handle /api/telemetry* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    
    # Optional: Route other service APIs if needed
    handle /api/storage* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }

    # Root-level API routes (without /api/ prefix)
    handle /info* {
