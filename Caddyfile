# Cross-Network Routes (Host Network → Bridge Network)
:8001 {
    reverse_proxy identity:8001
}

:8095 {
    reverse_proxy ma:8095
}

:11435 {
    log {
        output stdout
        level INFO
    }
    handle /v1/* {
        reverse_proxy gateway:11435
    }
    handle /api/* {
        reverse_proxy gateway:11435
    }
    handle /health {
        reverse_proxy gateway:11435
    }
    handle /health/* {
        reverse_proxy gateway:11435
    }
    handle / {
        reverse_proxy gateway:11435
    }
}

:8004 {
    reverse_proxy rag:8004
}

:8005 {
    reverse_proxy storage:8005
}

:8006 {
    reverse_proxy logging:8006
}

:8007 {
    reverse_proxy workspace_runtime:8007
}

:8008 {
    reverse_proxy control_plane:8008
}

# Standard Routes
:80 {
    log {
        output stdout
        level INFO
    }

    # 2. Route Chat/Gateway API traffic
    handle /v1/* {
        reverse_proxy gateway:11435
    }
    handle /api/chat* {
        reverse_proxy gateway:11435
    }
    handle /api/config* {
        reverse_proxy gateway:11435
    }
    handle /api/settings* {
        reverse_proxy identity:8001
    }
    handle /api/generate* {
        reverse_proxy gateway:11435
    }
    handle /api/history* {
        reverse_proxy gateway:11435
    }
    handle /api/discovery* {
        reverse_proxy gateway:11435
    }
    handle /api/communication* {
        reverse_proxy gateway:11435
    }
    handle /api/search* {
        reverse_proxy gateway:11435
    }
    handle /api/docs* {
        reverse_proxy gateway:11435
    }
    handle /api/workspaces* {
        reverse_proxy gateway:11435
    }
    handle /api/models* {
        reverse_proxy gateway:11435
    }
    handle /api/media* {
        reverse_proxy gateway:11435
    }
    handle /api/entities* {
        reverse_proxy gateway:11435
    }
    handle /api/sendspin {
        reverse_proxy gateway:11435 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle /api/ma-jsonrpc {
        reverse_proxy gateway:11435 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle /api/presence* {
        reverse_proxy gateway:11435
    }
    handle /api/integrations* {
        reverse_proxy gateway:11435
    }
    handle /api/groups* {
        reverse_proxy gateway:11435
    }
    handle /api/intercom* {
        reverse_proxy gateway:11435
    }



    handle /api/logs* {
        reverse_proxy logging:8006
    }

    handle /api/admin/logs* {
        reverse_proxy logging:8006
    }

    handle /execute* {
        reverse_proxy gateway:11435
    }

    handle /control_plane* {
        uri strip_prefix /control_plane
        reverse_proxy control_plane:8008
    }

    # 3. Route Identity/Auth API traffic
    handle /api/auth* {
        reverse_proxy identity:8001
    }
    handle /api/users* {
        reverse_proxy identity:8001
    }
    handle /api/devices* {
        reverse_proxy identity:8001
    }
    handle /api/resolve* {
        reverse_proxy identity:8001
    }
    handle /api/widgets* {
        reverse_proxy identity:8001
    }
    handle /api/telemetry* {
        reverse_proxy gateway:11435
    }
    
    # Optional: Route other service APIs if needed
    handle /api/storage* {
        reverse_proxy gateway:11435
    }

    # Root-level API routes (without /api/ prefix)
    handle /info* {
        reverse_proxy gateway:11435
    }

    handle /rag* {
        reverse_proxy rag:8004
    }

    handle /discovery* {
        reverse_proxy gateway:11435
    }

    handle /api/admin/raven* {
        reverse_proxy gateway:11435
    }
    handle /api/admin/services* {
        reverse_proxy gateway:11435
    }

    handle /api/raven* {
        reverse_proxy gateway:11435
    }

    handle /api/admin* {
        reverse_proxy workspace_runtime:8007
    }

    handle /api/workspace* {
        reverse_proxy workspace_runtime:8007
    }

    handle /api/webhook* {
        reverse_proxy workspace_runtime:8007
    }

    handle /health {
        reverse_proxy gateway:11435
    }

    handle /health/* {
        reverse_proxy gateway:11435
    }

    # Safety net: any /api/* not matched above → gateway (prevents falling
    # through to the UI container, whose nginx proxies /api back to Caddy → loop)
    handle /api/* {
        reverse_proxy gateway:11435
    }

    # Catch-all: Route UI traffic to the React container
    handle /* {
        reverse_proxy ui:8008
    }
}
