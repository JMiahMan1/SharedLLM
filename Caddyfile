    }
    handle /api/config* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/settings* {
        reverse_proxy identity:8001 {
            import patient
        }
    }
    handle /api/generate* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/history* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/discovery* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/communication* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/search* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/docs* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/workspaces* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/models* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/media* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/entities* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/sendspin {
        reverse_proxy gateway:11435 {
            import patient
            # Caddy already forwards X-Forwarded-Proto and sets X-Real-IP from the
            # client, so repeating them here only earned a startup warning.
            header_up X-Real-IP {remote_host}
        }
    }
    handle /api/ma-jsonrpc {
        reverse_proxy gateway:11435 {
            import patient
            # Caddy already forwards X-Forwarded-Proto and sets X-Real-IP from the
            # client, so repeating them here only earned a startup warning.
            header_up X-Real-IP {remote_host}
        }
    }
    handle /api/presence* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/integrations* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/groups* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/intercom* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }



    # WebSocket stream authenticates via ?token= (user API key) on logging.
    handle /api/logs/stream* {
        reverse_proxy logging:8006 {
            import patient
        }
    }

    handle /api/admin/logs* {
        reverse_proxy gateway:11435 {
            import patient
        }
