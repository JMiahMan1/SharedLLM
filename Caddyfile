        }
    }

    handle /api/raven* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }

    # Gateway routes under /api/admin; the rest of /api/admin is the
    # workspace runtime's (Caddy tries the longer path first).
    handle /api/admin/users/*/stars {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/admin/volumes* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/admin/dns* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }
    handle /api/admin* {
        reverse_proxy workspace_runtime:8007 {
            import patient
        }
    }

    handle /api/workspace* {
        reverse_proxy workspace_runtime:8007 {
            import patient
        }
    }

    handle /api/webhook* {
        reverse_proxy workspace_runtime:8007 {
            import patient
        }
    }

    handle /health {
        reverse_proxy gateway:11435 {
            import patient
        }
    }

    handle /health/* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }

    # Safety net: any /api/* not matched above → gateway (prevents falling
    # through to the UI container, whose nginx proxies /api back to Caddy → loop)
    handle /api/* {
        reverse_proxy gateway:11435 {
            import patient
        }
    }

    # UnifiedPush endpoints (docs/PUSH.md): outside servers POST to
    # /push/up<id>, which ntfy serves as topic up<id>. up=1 makes ntfy keep a
    # binary (encrypted) body as the message, base64-encoded, even from a
    # sender that does not say Content-Encoding: aes128gcm. Nothing else of
    # ntfy is reachable from outside; phones read through the gateway.
    # Bodies over 4096 bytes (the UnifiedPush minimum, and ntfy's
    # message-size-limit) are refused here with 413.
    handle /push/up* {
        @deliver method POST
        handle @deliver {
            request_body {
                max_size 4096
            }
            uri strip_prefix /push
            uri query up 1
            reverse_proxy ntfy:80
        }
        respond 405
    }

    # Catch-all: Route UI traffic to the React container
    handle /* {
        reverse_proxy ui:8008 {
            import patient
        }
    }
}
