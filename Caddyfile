# Public traffic reaches the :80 site through one reverse proxy
# (PUBLIC_PROXY_IP in .env). Trusting only that address keeps the client
# address it forwards in X-Forwarded-For, which ntfy needs to rate limit
# outside UnifiedPush senders (docs/PUSH.md, "Limits"). Any other peer has
# X-Forwarded-For replaced by its own address, so it cannot claim another.
{
    servers :80 {
        trusted_proxies static {$PUBLIC_PROXY_IP}
    }

    # Caddy's reverse proxy logs "aborting with incomplete response" at WARN every
    # time a long-lived stream ends -- the media events feed and the push stream,
    # whenever a phone closes the app or the screen sleeps. That is expected, and
    # it was 1400+ lines a day (measured 2026-10-26) drowning the warnings that
    # matter. Real failures from that logger are ERROR, so this raises its level
    # without touching the access log or any other logger.
    log reverse_proxy_noise {
        output stdout
        format json
        level ERROR
        include http.handlers.reverse_proxy
    }
}

# Cross-Network Routes (Host Network → Bridge Network)
:8001 {
    reverse_proxy identity:8001
}

:8095 {
    reverse_proxy ma:8095
}

:11435 {
    log {
        output stdout
        level INFO
        # Two secrets legitimately travel in a query string here: the git-pull
        # webhook's token, and the browser's ?token= on the Sendspin / JSON-RPC
        # WebSockets (a WebSocket handshake cannot carry an Authorization
        # header). Caddy's access log records the whole URI, so both were being
        # written to stdout in plain text -- confirmed live:
        #   /api/webhook/git-pull/sharedllm_system?token=s...
        # Redact them at the log, keep the rest of the URI for debugging.
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace mt REDACTED
                }
                request>headers>Authorization delete
            }
        }
    }
    handle /v1/* {
        reverse_proxy gateway:11435
    }
    handle /api/* {
        reverse_proxy gateway:11435
    }
    handle /health {
        reverse_proxy gateway:11435
    }
    handle /health/* {
        reverse_proxy gateway:11435
    }
    handle /execute* {
        reverse_proxy gateway:11435
    }
    handle / {
        reverse_proxy gateway:11435
    }
}

:8004 {
    reverse_proxy rag:8004
}

:8005 {
    reverse_proxy storage:8005
}

:8006 {
    reverse_proxy logging:8006
}

:8007 {
    reverse_proxy workspace_runtime:8007
}

:8008 {
    reverse_proxy control_plane:8008
}

:8009 {
    reverse_proxy geo:8009
}

:8010 {
    reverse_proxy bible:8010
}

# Standard Routes
:80 {
    log {
        output stdout
        level INFO
        # Two secrets legitimately travel in a query string here: the git-pull
        # webhook's token, and the browser's ?token= on the Sendspin / JSON-RPC
        # WebSockets (a WebSocket handshake cannot carry an Authorization
        # header). Caddy's access log records the whole URI, so both were being
        # written to stdout in plain text -- confirmed live:
        #   /api/webhook/git-pull/sharedllm_system?token=s...
        # Redact them at the log, keep the rest of the URI for debugging.
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace mt REDACTED
                }
                request>headers>Authorization delete
            }
        }
    }

    # 2. Route Chat/Gateway API traffic
    handle /v1/* {
        reverse_proxy gateway:11435
    }
    handle /api/chat* {
        reverse_proxy gateway:11435
    }
    handle /api/config* {
        reverse_proxy gateway:11435
    }
    handle /api/settings* {
        reverse_proxy identity:8001
    }
    handle /api/generate* {
        reverse_proxy gateway:11435
    }
    handle /api/history* {
        reverse_proxy gateway:11435
    }
    handle /api/discovery* {
        reverse_proxy gateway:11435
    }
    handle /api/communication* {
        reverse_proxy gateway:11435
    }
    handle /api/search* {
        reverse_proxy gateway:11435
    }
    handle /api/docs* {
        reverse_proxy gateway:11435
    }
    handle /api/workspaces* {
        reverse_proxy gateway:11435
    }
    handle /api/models* {
        reverse_proxy gateway:11435
    }
    handle /api/media* {
        reverse_proxy gateway:11435
    }
    handle /api/entities* {
        reverse_proxy gateway:11435
    }
    handle /api/sendspin {
        reverse_proxy gateway:11435 {
            # Caddy already forwards X-Forwarded-Proto and sets X-Real-IP from the
            # client, so repeating them here only earned a startup warning.
            header_up X-Real-IP {remote_host}
        }
    }
    handle /api/ma-jsonrpc {
        reverse_proxy gateway:11435 {
            # Caddy already forwards X-Forwarded-Proto and sets X-Real-IP from the
            # client, so repeating them here only earned a startup warning.
            header_up X-Real-IP {remote_host}
        }
    }
    handle /api/presence* {
        reverse_proxy gateway:11435
    }
    handle /api/integrations* {
        reverse_proxy gateway:11435
    }
    handle /api/groups* {
        reverse_proxy gateway:11435
    }
    handle /api/intercom* {
        reverse_proxy gateway:11435
    }



    # WebSocket stream authenticates via ?token= (user API key) on logging.
    handle /api/logs/stream* {
        reverse_proxy logging:8006
    }

    handle /api/admin/logs* {
        reverse_proxy gateway:11435
    }

    handle /execute* {
        reverse_proxy gateway:11435
    }

    handle /control_plane* {
        uri strip_prefix /control_plane
        reverse_proxy control_plane:8008
    }

    # 3. Route Identity/Auth API traffic
    handle /api/auth* {
        reverse_proxy identity:8001
    }
    # Location endpoints go through gateway so X-Internal-Secret is injected
    # (identity requires it; phone/UI never send it → 422 if hit directly).
    handle /api/users/*/location {
        reverse_proxy gateway:11435
    }
    handle /api/users/location* {
        reverse_proxy gateway:11435
    }
    handle /api/users* {
        reverse_proxy identity:8001
    }
    # Gateway routes under /api/devices (the watch's Home favorites, pairing
    # a companion device); everything else under it is identity's. Caddy
    # tries the longer path first.
    handle /api/devices/favorites* {
        reverse_proxy gateway:11435
    }
    handle /api/devices/pair* {
        reverse_proxy gateway:11435
    }
    handle /api/devices* {
        reverse_proxy identity:8001
    }
    handle /api/resolve* {
        reverse_proxy identity:8001
    }
    handle /api/widgets* {
        reverse_proxy identity:8001
    }
    handle /api/telemetry* {
        reverse_proxy gateway:11435
    }
    
    # Optional: Route other service APIs if needed
    handle /api/storage* {
        reverse_proxy gateway:11435
    }

    # Root-level API routes (without /api/ prefix)
    handle /info* {
        reverse_proxy gateway:11435
    }

    handle /rag* {
        reverse_proxy rag:8004
    }

    handle /discovery* {
        reverse_proxy gateway:11435
    }

    handle /api/admin/raven* {
        reverse_proxy gateway:11435
    }
    handle /api/admin/services* {
        reverse_proxy gateway:11435
    }

    handle /api/raven* {
        reverse_proxy gateway:11435
    }

    # Gateway routes under /api/admin; the rest of /api/admin is the
    # workspace runtime's (Caddy tries the longer path first).
    handle /api/admin/users/*/stars {
        reverse_proxy gateway:11435
    }
    handle /api/admin/volumes* {
        reverse_proxy gateway:11435
    }
    handle /api/admin/dns* {
        reverse_proxy gateway:11435
    }
    handle /api/admin* {
        reverse_proxy workspace_runtime:8007
    }

    handle /api/workspace* {
        reverse_proxy workspace_runtime:8007
    }

    handle /api/webhook* {
        reverse_proxy workspace_runtime:8007
    }

    handle /health {
        reverse_proxy gateway:11435
    }

    handle /health/* {
        reverse_proxy gateway:11435
    }

    # Safety net: any /api/* not matched above → gateway (prevents falling
    # through to the UI container, whose nginx proxies /api back to Caddy → loop)
    handle /api/* {
        reverse_proxy gateway:11435
    }

    # UnifiedPush endpoints (docs/PUSH.md): outside servers POST to
    # /push/up<id>, which ntfy serves as topic up<id>. up=1 makes ntfy keep a
    # binary (encrypted) body as the message, base64-encoded, even from a
    # sender that does not say Content-Encoding: aes128gcm. Nothing else of
    # ntfy is reachable from outside; phones read through the gateway.
    # Bodies over 4096 bytes (the UnifiedPush minimum, and ntfy's
    # message-size-limit) are refused here with 413.
    handle /push/up* {
        @deliver method POST
        handle @deliver {
            request_body {
                max_size 4096
            }
            uri strip_prefix /push
            uri query up 1
            reverse_proxy ntfy:80
        }
        respond 405
    }

    # Catch-all: Route UI traffic to the React container
    handle /* {
        reverse_proxy ui:8008
    }
}
