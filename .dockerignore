# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore git
.git/

# Ignore local virtual environments

# Ignore local virtual environments
.venv/
venv/
.env.docker

# Ignore editor files
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.vscode/
.idea/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore logs and temp
*.log
tmp/

# Runtime data lives in mounted volumes, never in images. Matches .gitignore:
# a server-side build (deploy_local_build.sh) used to send the live databases
# into every image's `COPY . .`, and failed outright on data/nominatim (owned
# by the postgres uid, unreadable to the deploying user).
data/*
!data/phrasebook.json
