# Pinned by digest, not just by tag: `3.11-slim` is a moving target, so a
# rebuild of the same commit could otherwise pick up a different interpreter
# and system libraries. This is the multi-arch index digest, so the amd64 and
# arm64 builds both still resolve (checked 2026-10-26).
FROM python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377

# Install system deps once: common tools for all containers
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    jq \
    iputils-ping \
    iputils-tracepath \
    dnsutils \
    net-tools \
    iproute2 \
    strace \
    ltrace \
    lsof \
    procps \
    tcpdump \
    nano \
    vim-tiny \
    ssh-client \
    gnupg \
    ca-certificates \
    tesseract-ocr \
    poppler-utils \
    file \
    less \
    tree \
    xxd \
    ripgrep \
    fd-find \
    fzf \
    traceroute \
    nmap \
    netcat-openbsd \
    xz-utils \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Bring the trust store up to what the root programs trust today.
#
# The package is upgraded first, so a future Debian bundle is picked up on a
# rebuild; today `trixie-security` offers nothing newer than the installed
# 20250419+deb13u1, which is a 2025-04-19 Mozilla snapshot, so the bundle still
# trusts roots that have since been
# distrusted: the eight eMudhra/emSign intermediates whose private keys turned out
# to be recoverable (October 2026), the COMODO root (TLS distrust April 2026),
# GLOBALTRUST 2020, the Entrust roots, the Trustwave roots, and older ones such as
# XRamp, Go Daddy Class 2, Starfield Class 2, SecureTrust and TeliaSonera. curl,
# Python and every service in this stack read this store rather than a browser's,
# so a browser update does not reach them. `emSign Root CA - G1` is deliberately
# kept: the root programs kept it too. Nineteen names are listed and eighteen
# exist in this bundle (`emSign ECC Root CA - G3` was never in Debian's), which is
# what the assertion below allows for.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && sed -i \
 -e "s|^mozilla/emSign_Root_CA_-_C1\.crt|!mozilla/emSign_Root_CA_-_C1.crt|" \
 -e "s|^mozilla/emSign_ECC_Root_CA_-_C3\.crt|!mozilla/emSign_ECC_Root_CA_-_C3.crt|" \
 -e "s|^mozilla/emSign_ECC_Root_CA_-_G3\.crt|!mozilla/emSign_ECC_Root_CA_-_G3.crt|" \
 -e "s|^mozilla/COMODO_Certification_Authority\.crt|!mozilla/COMODO_Certification_Authority.crt|" \
 -e "s|^mozilla/GLOBALTRUST_2020\.crt|!mozilla/GLOBALTRUST_2020.crt|" \
 -e "s|^mozilla/Entrust_Root_Certification_Authority\.crt|!mozilla/Entrust_Root_Certification_Authority.crt|" \
 -e "s|^mozilla/Entrust_Root_Certification_Authority_-_G2\.crt|!mozilla/Entrust_Root_Certification_Authority_-_G2.crt|" \
 -e "s|^mozilla/Entrust_Root_Certification_Authority_-_EC1\.crt|!mozilla/Entrust_Root_Certification_Authority_-_EC1.crt|" \
 -e "s|^mozilla/Entrust.net_Premium_2048_Secure_Server_CA\.crt|!mozilla/Entrust.net_Premium_2048_Secure_Server_CA.crt|" \
 -e "s|^mozilla/Trustwave_Global_Certification_Authority\.crt|!mozilla/Trustwave_Global_Certification_Authority.crt|" \
 -e "s|^mozilla/Trustwave_Global_ECC_P256_Certification_Authority\.crt|!mozilla/Trustwave_Global_ECC_P256_Certification_Authority.crt|" \
 -e "s|^mozilla/Trustwave_Global_ECC_P384_Certification_Authority\.crt|!mozilla/Trustwave_Global_ECC_P384_Certification_Authority.crt|" \
 -e "s|^mozilla/SecureTrust_CA\.crt|!mozilla/SecureTrust_CA.crt|" \
 -e "s|^mozilla/Secure_Global_CA\.crt|!mozilla/Secure_Global_CA.crt|" \
 -e "s|^mozilla/TeliaSonera_Root_CA_v1\.crt|!mozilla/TeliaSonera_Root_CA_v1.crt|" \
 -e "s|^mozilla/XRamp_Global_CA_Root\.crt|!mozilla/XRamp_Global_CA_Root.crt|" \
 -e "s|^mozilla/Go_Daddy_Class_2_CA\.crt|!mozilla/Go_Daddy_Class_2_CA.crt|" \
 -e "s|^mozilla/Starfield_Class_2_CA\.crt|!mozilla/Starfield_Class_2_CA.crt|" \
 -e "s|^mozilla/ePKI_Root_Certification_Authority\.crt|!mozilla/ePKI_Root_Certification_Authority.crt|" \
        /etc/ca-certificates.conf \
 && update-ca-certificates --fresh > /dev/null \
 && echo "trust store refreshed: $(grep -c '^mozilla/' /etc/ca-certificates.conf) roots enabled, $(grep -c '^!mozilla/' /etc/ca-certificates.conf) distrusted roots disabled" \
 && test "$(grep -c '^!mozilla/' /etc/ca-certificates.conf)" -ge 18

# CPU-only PyTorch (no CUDA libs), needed by RAG/gateway for embedding models
RUN pip install --no-cache-dir torch==2.14.1+cpu --index-url https://download.pytorch.org/whl/cpu

# Heavy ML/vector packages (fastembed, onnxruntime), only needed by RAG and gateway
# Installing in base so they're cached across all service builds.
#
# Pinned to the versions the image resolves today (read from the built
# image, 2026-10-26): an unpinned install meant a rebuild of the same
# commit could silently jump a major version. Transitive dependencies
# still float - pinning those needs a constraints file reconciled with
# every service's own requirements.txt.
RUN pip install --no-cache-dir \
    fastembed==0.9.1 \
    sqlmodel==0.0.48 \
    cryptography==50.0.2 \
    pydantic==2.14.1 \
    fastapi==0.162.0 \
    "uvicorn[standard]==0.54.0" \
    httpx==0.28.1 \
    websockets==17.3 \
    redis==8.1.0 \
    python-dotenv==1.2.4 \
    passlib[bcrypt]==1.7.4 \
    pydantic-settings==2.16.1 \
    python-multipart==0.0.32 \
    requests==2.34.2 \
    docker==7.2.0 \
    playwright==1.64.1 \
    yt-dlp==2026.10.21 \
    "kokoro-onnx==0.6.1" \
    soundfile==0.14.0 \
    caldav==3.6.0 \
    dateparser==1.4.3 \
    vobject==0.9.9 \
    python-dateutil==2.9.0.post0 \
    aiosqlite==0.22.1 \
    rokuecp==0.19.5 \
    aiowebostv==0.10.0 \
    samsungtvws==3.0.6 \
    pybravia==0.5.3 \
    pychromecast==14.0.10 \
    androidtv==0.0.75 \
    wakeonlan==4.0.0 \
    aioesphomeapi==46.22.0 \
    paho-mqtt==2.1.0 \
    dnspython==2.9.0 \
    easywebdav==1.2.0 \
    html2text==2025.4.15 \
    && playwright install --with-deps chromium

# Whisper without triton: its metadata requires triton on Linux, but triton
# (about 900 MB) only compiles GPU kernels and this stack runs on the CPU.
# Its other dependencies are installed by name; the check fails the build if
# something brings triton back or Whisper stops importing.
RUN pip install --no-cache-dir --no-deps openai-whisper==20250625 \
    && pip install --no-cache-dir more-itertools==11.2.1 numba==0.68.0 tiktoken==0.14.0 tqdm==4.70.1 \
    && python -c "import whisper" \
    && ! pip show triton >/dev/null 2>&1

# Testing and dev tools, available in all containers for debugging
RUN pip install --no-cache-dir \
    pytest==9.1.1 \
    pytest-asyncio==1.4.1 \
    pytest-mock==3.17.0 \
    respx==0.23.1 \
    ruff==0.17.2 \
    mypy==2.4.0 \
    flake8==7.4.1 \
    black==26.10.1 \
    isort==9.0.2 \
    pre_commit==4.7.0 \
    bandit==1.9.4 \
    pip_audit==2.10.1 \
    httpx==0.28.1 \
    requests-mock==1.12.1 \
    responses==0.26.3

# The packaging tools ship in this image and both had 2026 advisories: pip 24.0
# carries seven (fixed in 25.3 through 26.2) and setuptools 79.0.1 two (fixed in
# 83.0.0 and 84.1.0). filelock 3.32.3 is in the same position - 4.2.1 fixes a
# ReadWriteLock issue where SQLite reopened the lock database and its side files
# by name, so a planted symlink or journal file in a writable parent could cause
# an overwrite or unlink (CVE-2026-112940 and two siblings). `safety` used to be
# installed here; it is not used by CI or any script, it pins filelock<4.0, and
# that pin was what kept this image on the vulnerable filelock. pip-audit and
# bandit remain for scanning. This runs last so the installs above still use the
# resolver they were tested with.
RUN pip install --no-cache-dir --upgrade \
    pip==26.2.2 \
    setuptools==84.2.1 \
    filelock==4.2.4

# Pre-download nomic-ai/nomic-embed-text-v1.5 model (cached across all services).
# The download lands in /tmp/fastembed_cache owned by root, and the services that
# use it run as the host user, so huggingface_hub could not refresh its tree cache
# and logged "Ignoring corrupted tree cache file ... Permission denied" on every
# embedder start - a warning that reads like a broken model and is not one. The
# cache is made writable by anyone so the runtime user can keep it fresh.
RUN python -c "from fastembed import TextEmbedding; TextEmbedding(model_name='nomic-ai/nomic-embed-text-v1.5')" \
    && chmod -R a+rwX /tmp/fastembed_cache

ENV PYTHONPATH=/app
ENV HF_HUB_ENABLE_HF_TRANSFER=1
